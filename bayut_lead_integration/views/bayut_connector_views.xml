<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bayut_connector_view_form" model="ir.ui.view">
        <field name="name">bayut.connector.view.form</field>
        <field name="model">bayut.connector</field>
        <field name="arch" type="xml">
            <form string="Bayut Profolio Connector Hub" create="0" delete="0">
                <header>
                    <button name="action_test_connection"
                            string="Test Connection"
                            type="object"
                            class="btn-secondary"
                            icon="fa-plug"/>
                    <button name="action_sync_listings_now"
                            string="Sync Listings to Bayut"
                            type="object"
                            class="btn-primary"
                            icon="fa-cloud-upload"/>
                    <button name="action_sync_now"
                            string="Sync Leads Now"
                            type="object"
                            class="btn-primary"
                            icon="fa-download"/>
                    <button name="action_import_from_odoo_properties"
                            string="Import Units from Property Management"
                            type="object"
                            class="btn-secondary"
                            icon="fa-building-o"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_listings"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-home">
                            <field name="listing_count" widget="statinfo" string="Listings"/>
                        </button>
                        <button name="action_view_bayut_leads"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-star">
                            <field name="bayut_lead_count" widget="statinfo" string="Bayut Leads"/>
                        </button>
                        <button name="action_view_sync_logs"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-history">
                            <field name="log_count" widget="statinfo" string="Sync Logs"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Bayut Listing API (Profolio Inventory)">
                            <field name="listing_api_url"/>
                            <field name="listing_api_key" password="True"/>
                            <field name="xml_feed_url" widget="CopyClipboardChar" readonly="1"/>
                            <field name="json_feed_url" widget="CopyClipboardChar" readonly="1"/>
                            <field name="last_listing_sync" readonly="1"/>
                        </group>
                        <group string="Bayut Leads API &amp; CRM Assignment">
                            <field name="api_url"/>
                            <field name="api_key" password="True"/>
                            <field name="webhook_url" widget="CopyClipboardChar" readonly="1"/>
                            <field name="default_team_id"/>
                            <field name="default_user_id"/>
                            <field name="sync_interval"/>
                            <field name="last_sync" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Recent Sync &amp; Activity Logs" name="sync_logs">
                            <field name="log_ids" readonly="1">
                                <list create="0" edit="0"
                                      decoration-success="status == 'success'"
                                      decoration-danger="status == 'error'">
                                    <field name="sync_datetime"/>
                                    <field name="sync_type" widget="badge"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'success'"
                                           decoration-danger="status == 'error'"/>
                                    <field name="leads_created"/>
                                    <field name="listings_synced"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bayut_connector" model="ir.actions.act_window">
        <field name="name">Bayut Connector Hub</field>
        <field name="res_model">bayut.connector</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="bayut_lead_integration.bayut_connector_default"/>
    </record>
</odoo>
