<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bayut_sync_log_view_list" model="ir.ui.view">
        <field name="name">bayut.sync.log.view.list</field>
        <field name="model">bayut.sync.log</field>
        <field name="arch" type="xml">
            <list string="Bayut Sync Logs" create="0" edit="0"
                  decoration-success="status == 'success'"
                  decoration-danger="status == 'error'">
                <field name="sync_datetime"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'success'"
                       decoration-danger="status == 'error'"/>
                <field name="leads_created"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="bayut_sync_log_view_form" model="ir.ui.view">
        <field name="name">bayut.sync.log.view.form</field>
        <field name="model">bayut.sync.log</field>
        <field name="arch" type="xml">
            <form string="Bayut Sync Log" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="sync_datetime"/>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'success'"
                                   decoration-danger="status == 'error'"/>
                        </group>
                        <group>
                            <field name="leads_created"/>
                            <field name="connector_id"/>
                        </group>
                    </group>
                    <group string="Execution Message">
                        <field name="message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bayut_sync_log_view_search" model="ir.ui.view">
        <field name="name">bayut.sync.log.view.search</field>
        <field name="model">bayut.sync.log</field>
        <field name="arch" type="xml">
            <search string="Search Bayut Sync Logs">
                <field name="message"/>
                <filter string="Success" name="filter_success" domain="[('status', '=', 'success')]"/>
                <filter string="Error" name="filter_error" domain="[('status', '=', 'error')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                    <filter string="Sync Date" name="group_by_date" context="{'group_by': 'sync_datetime'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bayut_sync_log" model="ir.actions.act_window">
        <field name="name">Bayut Sync Logs</field>
        <field name="res_model">bayut.sync.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Bayut synchronization logs recorded yet.
            </p>
            <p>
                Configure your Bayut API credentials in <b>Settings &gt; CRM</b> and click <b>Sync Now</b>.
            </p>
        </field>
    </record>

    <menuitem id="menu_bayut_sync_logs"
              name="Bayut Sync Logs"
              parent="crm.crm_menu_config"
              action="action_bayut_sync_log"
              groups="sales_team.group_sale_manager"
              sequence="95"/>
</odoo>
