<odoo>
    <data>
        <record id="property_service_view_list" model="ir.ui.view">
            <field name="name">property.service.list</field>
            <field name="model">property.service</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="name" required="1"/>
                    <field name="code" required="1"/>
                    <field name="active"/>
                </list>
            </field>
        </record>
        <record id="action_property_service" model="ir.actions.act_window">
            <field name="name">Service</field>
            <field name="res_model">property.service</field>
            <field name="view_mode">list</field>
        </record>

        <menuitem id="property_service_submenu" name="Service" parent="property_configuration_menu"
                  action="action_property_service" sequence="20"/>
    </data>
</odoo>