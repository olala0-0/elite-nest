<odoo>
    <record id="ir_cron_contract_expiry" model="ir.cron">
        <field name="name">Contract Expiry</field>
        <field name="model_id" ref="model_rent_contract"/>
        <field name="state">code</field>
        <field name="code">model.action_contract_expiry_cron()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_rent_due_reminder" model="ir.cron">
        <field name="name">Rent Due Reminder</field>
        <field name="model_id" ref="model_rent_contract"/>
        <field name="state">code</field>
        <field name="code">model.action_rent_due_reminder_cron()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_apply_penalty" model="ir.cron">
        <field name="name">Apply Penalty</field>
        <field name="model_id" ref="model_rent_contract"/>
        <field name="state">code</field>
        <field name="code">model.action_apply_penalty_cron()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_auto_invoice_contract" model="ir.cron">
        <field name="name">Auto Create Rent Invoices</field>
        <field name="model_id" ref="model_rent_contract"/>
        <field name="state">code</field>
        <field name="code">model.action_auto_create_invoice_cron()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

