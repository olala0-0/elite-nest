<odoo>
    <record id="Property_detail_sequence_data" model="ir.sequence">
        <field name="name">Property Detail</field>
        <field name="code">property.detail</field>
        <field name="prefix">PD/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="sale_contract_sequence_data" model="ir.sequence">
        <field name="name">Selling Contract</field>
        <field name="code">sale.contract</field>
        <field name="prefix">SC/%(year)s/%(month)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="renting_contract_sequence_data" model="ir.sequence">
        <field name="name">Renting Contract</field>
        <field name="code">rent.contract</field>
        <field name="prefix">RC/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="crm_lead_sequence_data" model="ir.sequence">
        <field name="name">CRM Lead</field>
        <field name="code">crm.lead</field>
        <field name="prefix">Lead/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="property_inspection_sequence_data" model="ir.sequence">
        <field name="name">Property Inspection</field>
        <field name="code">property.inspection</field>
        <field name="prefix">INSP/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>