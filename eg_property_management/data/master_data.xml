<odoo>
    <data noupdate="1">
        <record id="property_residential_type_apartment" model="property.residential.type">
            <field name="name">Apartment</field>
        </record>
        <record id="property_residential_type_raw_house" model="property.residential.type">
            <field name="name">Residential / Raw House</field>
        </record>

        <record id="property_payment_term_monthly" model="property.payment.term">
            <field name="name">Monthly</field>
            <field name="interval_number">1</field>
            <field name="interval_unit">months</field>
        </record>
        <record id="property_payment_term_quarterly" model="property.payment.term">
            <field name="name">Quarterly</field>
            <field name="interval_number">3</field>
            <field name="interval_unit">months</field>
        </record>
        <record id="property_payment_term_yearly" model="property.payment.term">
            <field name="name">Yearly</field>
            <field name="interval_number">12</field>
            <field name="interval_unit">months</field>
        </record>

        <record id="product_product_installment_1" model="product.product">
            <field name="name">Installment Property Payment</field>
        </record>
        <record id="product_product_deposit_2" model="product.product">
            <field name="name">Property Deposit</field>
        </record>
        <record id="product_product_maintenance_4" model="product.product">
            <field name="name">Property Maintenance</field>
        </record>
        <record id="product_product_penalty_3" model="product.product">
            <field name="name">Penalty</field>
        </record>

        <record id="config_param_rent_invoice_product" model="ir.config_parameter">
            <field name="key">eg_property_management.rent_invoice_product_id</field>
            <field name="value" eval="str(ref('eg_property_management.product_product_installment_1'))"/>
        </record>
        <record id="config_param_rent_invoice_description" model="ir.config_parameter">
            <field name="key">eg_property_management.rent_invoice_description</field>
            <field name="value">Rent Installment</field>
        </record>
        <record id="config_param_deposit_invoice_product" model="ir.config_parameter">
            <field name="key">eg_property_management.deposit_invoice_product_id</field>
            <field name="value" eval="str(ref('eg_property_management.product_product_deposit_2'))"/>
        </record>
        <record id="config_param_deposit_invoice_description" model="ir.config_parameter">
            <field name="key">eg_property_management.deposit_invoice_description</field>
            <field name="value">Security Deposit</field>
        </record>
        <record id="config_param_maintenance_invoice_product" model="ir.config_parameter">
            <field name="key">eg_property_management.maintenance_invoice_product_id</field>
            <field name="value" eval="str(ref('eg_property_management.product_product_maintenance_4'))"/>
        </record>
        <record id="config_param_maintenance_invoice_description" model="ir.config_parameter">
            <field name="key">eg_property_management.maintenance_invoice_description</field>
            <field name="value">Maintenance Charge</field>
        </record>
        <record id="config_param_penalty_invoice_product" model="ir.config_parameter">
            <field name="key">eg_property_management.penalty_invoice_product_id</field>
            <field name="value" eval="str(ref('eg_property_management.product_product_penalty_3'))"/>
        </record>
        <record id="config_param_penalty_invoice_description" model="ir.config_parameter">
            <field name="key">eg_property_management.penalty_invoice_description</field>
            <field name="value">Penalty</field>
        </record>
    </data>
    <data>
        <function model="property.residential.type" name="action_sync_residential_types"/>
        <function model="property.payment.term" name="action_sync_existing_payment_terms"/>
    </data>
</odoo>
