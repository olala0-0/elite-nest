<odoo>
    <data>
        <record id="property_paper_format_report_sheet_a4" model="report.paperformat">
            <field name="name">Property Detail Report</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">8</field>
            <field name="margin_bottom">8</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="dpi">96</field>
        </record>

        <record id="report_property_detail_brochure_custom" model="ir.actions.report">
            <field name="name">Property Brochure</field>
            <field name="model">property.detail</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">eg_property_management.report_property_brochure</field>
            <field name="report_file">eg_property_management.report_property_brochure</field>
            <field name="paperformat_id" ref="eg_property_management.property_paper_format_report_sheet_a4"/>
            <field name="print_report_name">'Property Brochure - %s' % (object.name)</field>
            <field name="binding_type">report</field>
            <field name="binding_model_id" ref="model_property_detail"/>
        </record>
    </data>
</odoo>