<odoo>
    <template id="report_movein_permit_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1F2937; background-color: #FFFFFF; padding: 10px;">

                        <div style="border-bottom: 2px solid #1F2937; padding-bottom: 12px; margin-bottom: 20px;">
                            <h2 style="font-weight: 700; color: #111827; font-size: 22px; margin: 0; text-transform: uppercase; letter-spacing: 0.5px;">
                                Move-In Permit
                            </h2>
                            <p style="color: #4B5563; font-size: 13px; margin: 4px 0 0 0;">
                                Contract Reference: <strong style="color: #2563EB;"><span t-field="o.rent_contract_id.name"/></strong>
                            </p>
                        </div>

                        <p style="font-size: 13px; color: #1F2937; line-height: 1.6;">
                            This permit authorizes the below-named tenant to move into the property described
                            below. Security personnel should permit move-in activities (vehicle access, loading
                            of belongings, etc.) on or after the Move-In Date indicated.
                        </p>

                        <div style="background-color: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 6px; padding: 14px; margin-top: 16px;">
                            <table style="width: 100%; font-size: 13px; border-collapse: collapse; color: #374151;">
                                <tr>
                                    <td style="padding: 5px 0; width: 30%; font-weight: 600; color: #6B7280;">Tenant Name:</td>
                                    <td style="padding: 5px 0; color: #111827; font-weight: 600;"><span t-field="o.tenant_id.name"/></td>
                                </tr>
                                <tr>
                                    <td style="padding: 5px 0; font-weight: 600; color: #6B7280;">Property:</td>
                                    <td style="padding: 5px 0; color: #111827;"><span t-field="o.property_id.name"/></td>
                                </tr>
                                <tr>
                                    <td style="padding: 5px 0; font-weight: 600; color: #6B7280;">Move-In / Handover Date:</td>
                                    <td style="padding: 5px 0; color: #111827;">
                                        <span t-field="o.handover_date" t-options="{'widget': 'date', 'format': 'dd-MMM-yyyy'}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 5px 0; font-weight: 600; color: #6B7280;">Permit Issued On:</td>
                                    <td style="padding: 5px 0; color: #111827;">
                                        <span t-field="o.move_in_permit_date" t-options="{'widget': 'date', 'format': 'dd-MMM-yyyy'}"/>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <div style="margin-top: 60px; display: flex; justify-content: space-between;">
                            <div style="width: 45%; border-top: 1px solid #9CA3AF; padding-top: 6px; font-size: 12px; color: #6B7280;">
                                Property Management Signature
                            </div>
                            <div style="width: 45%; border-top: 1px solid #9CA3AF; padding-top: 6px; font-size: 12px; color: #6B7280;">
                                Security Signature
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
