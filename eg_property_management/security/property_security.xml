<odoo>
    <data>
        <record id="module_category_property_management" model="ir.module.category">
            <field name="name">Property Management</field>
            <field name="description">Access levels for Property Management</field>
            <field name="sequence">25</field>
        </record>

        <record id="privilege_property_finance_approver" model="res.groups.privilege">
            <field name="name">Move-Out Finance Approver</field>
            <field name="category_id" ref="module_category_property_management"/>
        </record>

        <record id="group_property_finance_approver" model="res.groups">
            <field name="name">Finance Approver (Move-Out)</field>
            <field name="privilege_id" ref="privilege_property_finance_approver"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Users with this access right can review Move-Out deductions and approve deposit releases.</field>
        </record>
    </data>
</odoo>
