<odoo>
    <record id="view_move_form_inherit_property" model="ir.ui.view">
        <field name="name">account.move.form.inherit.property</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <!-- 
                This positions the Property and Rent Contract fields directly 
                after the Customer (partner_id) field on the invoice sheet.
            -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="property_id" options="{'no_create': True, 'no_create_edit': True}" 
                       placeholder="Select Linked Property..."/>
                <field name="rent_contract_id" options="{'no_create': True, 'no_create_edit': True}" 
                       invisible="not rent_contract_id"/>
            </xpath>
        </field>
    </record>
</odoo>
