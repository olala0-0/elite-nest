<odoo>
    <record id="view_move_form_inherit_property" model="ir.ui.view">
        <field name="name">account.move.form.inherit.property</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <!-- 
            We set the priority to 999. This guarantees Odoo loads our view last, 
            overriding any background layout rules or views from other modules.
        -->
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <!-- 
                Using sheet/group/field ensures we target the main visible Customer field 
                on the invoice sheet, making both fields permanently visible.
            -->
            <xpath expr="//sheet//field[@name='partner_id']" position="after">
                <field name="property_id" options="{'no_create': True, 'no_create_edit': True}" 
                       placeholder="Select Linked Property..."/>
                <field name="rent_contract_id" options="{'no_create': True, 'no_create_edit': True}" 
                       placeholder="Select Rent Contract..."/>
            </xpath>
        </field>
    </record>
</odoo>
