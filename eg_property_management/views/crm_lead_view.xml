<odoo>
    <record id="crm_lead_property_form_view" model="ir.ui.view">
        <field name="name">crm.lead.form</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='lead_partner']/field[@name='partner_id']" position="before">
                <field name="property_id" options="{'no_create_edit': True, 'no_create': True}"/>
            </xpath>
            <xpath expr="//group[@name='opportunity_partner']/field[@name='partner_id']" position="before">
                <field name="property_id" options="{'no_create_edit': True, 'no_create': True}"/>
            </xpath>

            <xpath expr="//header" position="inside">
                <button name="action_create_rent_contract" string="Create Rent Contract" type="object"
                        class="btn-primary"
                        invisible="not property_id or not partner_id"/>
            </xpath>
        </field>
    </record>
</odoo>
