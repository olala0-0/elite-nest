<record id="view_property_search" model="ir.ui.view">
            <field name="name">property.detail.search</field>
            <field name="model">property.detail</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" string="Property Name"/>
                    <field name="landlord_id" string="Landlord"/>
                    <field name="city" string="City"/>
                    <field name="tag_ids" string="Tags"/>
                    <field name="country_id" string="Country"/>
                    <field name="residential_type_id" string="Residential Type"/>
                    <field name="company_id" string="Company"/>
                    
                    <filter string="For Sale" name="for_sale" domain="[('property_for','=','sale')]"/>
                    <filter string="For Rent" name="for_rent" domain="[('property_for','=','rent')]"/>
                    <filter string="Available" name="available" domain="[('state','=','available')]"/>
                    <filter string="On Rent" name="on_rent" domain="[('state','=','on_rent')]"/>
                    <filter string="Sold" name="sold" domain="[('state','=','sold')]"/>

                    <group string="Group By">
                        <filter string="Project" name="group_project" context="{'group_by':'project_id'}"/>
                        <filter string="Sub Project" name="group_sub_project" context="{'group_by':'sub_project_id'}"/>
                        <filter string="Property Type" name="group_property_type" context="{'group_by':'property_type'}"/>
                        <filter string="Property For" name="group_property_for" context="{'group_by':'property_for'}"/>
                        <filter string="Residential Type" name="group_residential_type" context="{'group_by':'residential_type_id'}"/>
                        <filter string="Landlord" name="group_landlord_id" context="{'group_by':'landlord_id'}"/>
                        <filter string="City" name="group_city" context="{'group_by':'city'}"/>
                        <filter string="Status" name="group_status" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>
