<odoo>
    <data>
        <record id="property_payment_term_view_list" model="ir.ui.view">
            <field name="name">property.payment.term.list</field>
            <field name="model">property.payment.term</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="name" required="1"/>
                    <field name="interval_number" required="1"/>
                    <field name="interval_unit" required="1"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="property_payment_term_view_form" model="ir.ui.view">
            <field name="name">property.payment.term.form</field>
            <field name="model">property.payment.term</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name" required="1"/>
                            <field name="interval_number" required="1"/>
                            <field name="interval_unit" required="1"/>
                            <field name="active"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_property_payment_term" model="ir.actions.act_window">
            <field name="name">Payment Terms</field>
            <field name="res_model">property.payment.term</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="property_payment_term_submenu" name="Payment Terms" parent="property_configuration_menu"
                  action="action_property_payment_term" sequence="15"/>
    </data>
</odoo>
