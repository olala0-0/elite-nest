<odoo>
    <record id="property_project_list_view" model="ir.ui.view">
        <field name="name">property.project.list</field>
        <field name="model">property.project</field>
        <field name="arch" type="xml">
            <list>
                <field name="code" string="Code"/>
                <field name="name" string="Name"/>
                <field name="property_type" string="Type"/>
                <field name="residential_type_id" string="SubType"/>
                <field name="property_for"/>
                <field name="state_id" string="Region"/>
                <field name="company_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="property_project_form_view" model="ir.ui.view">
        <field name="name">property.project.form</field>
        <field name="model">property.project</field>
        <field name="arch" type="xml">
            <form string="Property Project">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,available"/>
                    <button name="action_set_draft" string="Reset to Draft" type="object" class="btn-secondary"
                            invisible="state in ['draft','close']"/>
                    <button name="action_set_available" string="Available" type="object" class="btn-primary"
                            invisible="state in ['available','close']"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" class="oe_stat_button" name="action_open_documents"
                                icon="fa-file-text-o">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                        <button type="object" class="oe_stat_button" name="action_open_sub_projects"
                                icon="fa-building" invisible="is_sub_project == False">
                            <field name="sub_project_count" widget="statinfo" string="Sub Projects"/>
                        </button>
                        <button type="object" class="oe_stat_button" name="action_open_property_detail"
                                icon="fa-building" invisible="is_sub_project == True">
                            <field name="property_detail_count" widget="statinfo" string="Property"/>
                        </button>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <h1>
                        <field name="name" placeholder="Project Name"/>
                    </h1>
                    <field name="code" placeholder="Code" readonly="1"/>
                    <br/>
                    <hr style="border: 1px solid #000;"/>
                    <label for="is_sub_project" string="Sub Project"/>
                    <field name="is_sub_project"/>
                    <group string="Project Details">
                        <field name="property_type" widget="radio" options="{'horizontal': true}" required="1"/>
                        <field name="residential_type_id" required="1"/>
                        <field name="property_for" widget="radio" options="{'horizontal': true}" required="1"/>
                        <field name="landlord_id" required="1"/>
                        <field name="company_id" required="1"/>
                    </group>
                    <group>
                        <group string="Address Details">
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city" placeholder="City" class="o_address_city"/>
                                <field name="state_id" class="o_address_state" placeholder="State" can_write="True"
                                       options="{'no_open': True, 'no_quick_create': True}" can_create="True"
                                       context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                <field name="country_id" placeholder="Country" can_create="True" can_write="True"
                                       options="{'no_open': True, 'no_create': True}" class="o_address_country"/>
                            </div>
                        </group>
                        <group string="Additional Details">
                            <field name="construction_year" required="1"/>
                            <field name="date_of_project" required="1"/>
                            <field name="brochure" widget="url" placeholder="https://example.com/brochure.pdf"/>
                            <field name="website" widget="url" placeholder="https://example.com"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Basic Details">
                            <group>
                                <field name="valuation_of" widget="radio" options="{'horizontal': true}"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                            <group string="Area of Project">
                                <field name="total_subprojects"/>
                                <field name="total_property_area"/>
                                <field name="available_area"/>
                            </group>
                            <group string="Valuation of Project">
                                <field name="total_value"/>
                                <field name="total_maintenance"/>
                                <field name="total_collection"/>
                                <field name="scope_collection"/>
                            </group>
                        </page>
                        <page string="Description" invisible="is_description == False">
                            <field name="description" placeholder="Description..."/>
                        </page>
                        <page string="Other Detail" name="project_other_detail">
                            <group>
                                <group>
                                    <field name="project_manager_id" widget="many2one_avatar_user"/>
                                    <field name="priority" widget="priority"/>
                                    <field name="internal_ref"/>
                                    <field name="origin"/>
                                </group>
                                <group>
                                    <field name="tag_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                            <group>
                                <field name="notes" placeholder="Add notes here..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="property_project_search_view" model="ir.ui.view">
        <field name="name">property.project.search</field>
        <field name="model">property.project</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Property Name"/>
                <field name="landlord_id" string="Landlord"/>
                <field name="city" string="City"/>
                <field name="residential_type_id" string="Residential Type"/>
                <field name="company_id" string="Company"/>
                <filter string="Available" name="available" domain="[('state','=','available')]"/>
                <group expand="0" string="Group By">
                    <filter string="Residential Type" name="group_residential_type" context="{'group_by':'residential_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_property_project" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">property.project</field>
        <field name="view_mode">list,form,activity</field>
    </record>
</odoo>