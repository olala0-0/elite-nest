<odoo>
    <data>
        <record id="property_residential_type_view_list" model="ir.ui.view">
            <field name="name">property.residential.type.list</field>
            <field name="model">property.residential.type</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="name" required="1"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="action_property_residential_type" model="ir.actions.act_window">
            <field name="name">Residential Types</field>
            <field name="res_model">property.residential.type</field>
            <field name="view_mode">list</field>
        </record>

        <menuitem id="property_residential_type_submenu" name="Residential Types" parent="property_configuration_menu"
                  action="action_property_residential_type" sequence="12"/>
    </data>
</odoo>
