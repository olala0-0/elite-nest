<odoo>
    <data>
        <record id="property_section_view_list" model="ir.ui.view">
            <field name="name">property.section.list</field>
            <field name="model">property.section</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="name" required="1"/>
                </list>
            </field>
        </record>
        <record id="action_property_section" model="ir.actions.act_window">
            <field name="name">Property Section</field>
            <field name="res_model">property.section</field>
            <field name="view_mode">list</field>
        </record>

        <menuitem id="property_section_submenu" name="Section" parent="property_configuration_menu"
                  action="action_property_section" sequence="30"/>
    </data>
</odoo>