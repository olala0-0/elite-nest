<odoo>
    <data>
        <record id="property_tag_view_list" model="ir.ui.view">
            <field name="name">property.tag.list</field>
            <field name="model">property.tag</field>
            <field name="arch" type="xml">
                <list string="Tags" editable="bottom" sample="1">
                    <field name="name" required="1"/>
                    <field name="color" widget="color_picker" required="1"/>
                </list>
            </field>
        </record>

        <record id="action_property_tag" model="ir.actions.act_window">
            <field name="name">Properties Tags</field>
            <field name="res_model">property.tag</field>
            <field name="view_mode">list</field>
        </record>

        <menuitem id="property_configuration_menu" name="Configuration" parent="property_management_menu"
                  sequence="120"/>
        <menuitem id="property_tag_submenu" name="Tags" parent="property_configuration_menu"
                  action="action_property_tag" sequence="10"/>
    </data>
</odoo>