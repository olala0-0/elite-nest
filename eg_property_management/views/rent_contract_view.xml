<odoo>
    <data>
        <record id="rent_contract_list_view" model="ir.ui.view">
            <field name="name">rent.contract.list</field>
            <field name="model">rent.contract</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="property_id"/>
                    <field name="residential_type_id" string="Residential Type"/>
                    <field name="tenant_id"/>
                    <field name="landlord_id"/>
                    <field name="total_area"/>
                    <field name="rent"/>
                    <field name="duration"/>
                    <field name="contract_days"/>
                    <field name="remaining_days"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="currency_id" column_invisible="True"/>
                    <field name="user_id" widget="many2one_avatar_user"/>
                    <field name="activity_ids" widget="list_activity"/>
                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'running'" decoration-danger="state == 'cancel'" decoration-warning="state == 'expire'"/>
                </list>
            </field>
        </record>

        <record id="rent_contract_form_view" model="ir.ui.view">
            <field name="name">rent.contract.form</field>
            <field name="model">rent.contract</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="draft,running,cancel,close,expire"/>
                        <button name="action_state_draft" string="Reset to Draft" type="object" class="btn-secondary" invisible="state in ['draft','running','cancel','expire']"/>
                        <button name="action_state_running" string="Running" type="object" class="btn-primary" invisible="state in ['running','cancel','close','expire']"/>
                        <button name="action_create_invoice" string="Create Invoice" type="object" class="btn-primary" invisible="state in ['draft','cancel','close','expire']"/>
                        <button name="action_state_close" string="Close Contract" type="object" class="btn-secondary" invisible="state in ['draft','cancel','close','expire']"/>
                        <button name="action_state_cancel" string="Cancel" type="object" class="btn-secondary" invisible="state in ['draft','cancel','close','expire']"/>
                        <button name="action_create_broker_bill" string="Create Broker Bill" type="object" class="btn-primary" invisible="not broker_id or not broker_commission or state != 'running' or has_broker_bill == True"/>
                        <button name="%(action_rent_contract_extend_wizard)d" string="Extend Contract" type="action" class="btn-primary" invisible="state in ['draft','running','cancel','close']"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button type="object" class="oe_stat_button" icon="fa-files-o" name="action_view_invoices">
                                <field name="invoice_count" widget="statinfo" string="Invoices"/>
                            </button>
                            <button type="object" class="oe_stat_button" icon="fa-list-alt" name="action_view_broker_bills" string="Brokers"/>
                        </div>
                        <h1><field name="name" readonly="1"/></h1>
                        <group string="Contract Details">
                            <group>
                                <field name="start_date" required="1" readonly="state == 'running'"/>
                                <field name="end_date" required="1" readonly="state == 'running'"/>
                                <field name="rent" required="1" readonly="state == 'running'"/>
                                <field name="deposit" required="1" readonly="state == 'running'"/>
                                <field name="invoice_start_date" required="1"/>
                            </group>
                            <group>
                                <field name="duration" readonly="1"/>
                                <field name="contract_days" readonly="1"/>
                                <field name="remaining_days" readonly="1"/>
                                <field name="payment_term_id" required="1" readonly="state == 'running'"/>
                                <field name="payment_count" readonly="1"/>
                                <field name="contract_type" required="1" readonly="state == 'running'"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Property Information">
                                <group>
                                    <group>
                                        <field name="property_id" required="1" domain="[('property_for','=','rent')]"/>
                                        <field name="residential_type_id" string="Residential Type" readonly="1"/>
                                        <label for="street" string="Address"/>
                                        <div class="o_address_format">
                                            <field name="street" placeholder="Street..." class="o_address_street"/>
                                            <field name="city" placeholder="City" class="o_address_city"/>
                                            <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True}"/>
                                            <field name="country_id" placeholder="Country" class="o_address_country" options="{'no_open': True}"/>
                                        </div>
                                    </group>
                                    <group>
                                        <field name="company_id" required="1"/>
                                        <field name="tenant_id" required="1"/>
                                        <field name="landlord_id" required="1"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Rent Installments">
                                <field name="rent_installment_ids">
                                    <list editable="bottom">
                                        <field name="invoice_date"/>
                                        <field name="payment_type"/>
                                        <field name="amount"/>
                                        <field name="invoice_id"/>
                                    </list>
                                </field>
                            </page>
                            <page string="P/L Summary">
                                <group>
                                    <table style="width: 100%; border: 1px solid #D1D5DB; border-collapse: collapse;">
                                        <thead style="background-color: #F3F4F6;">
                                            <tr>
                                                <th style="padding: 10px; border-bottom: 1px solid #D1D5DB;">Type</th>
                                                <th style="padding: 10px; border-bottom: 1px solid #D1D5DB;">Expected</th>
                                                <th style="padding: 10px; border-bottom: 1px solid #D1D5DB;">Paid</th>
                                                <th style="padding: 10px; border-bottom: 1px solid #D1D5DB;">Due</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td style="padding: 10px;">Invoices</td>
                                                <td><field name="invoice_expected_amount"/></td>
                                                <td style="background-color: #D1FAE5;"><field name="invoice_paid_amount"/></td>
                                                <td style="background-color: #FEE2E2;"><field name="invoice_due_amount"/></td>
                                            </tr>
                                            <tr style="font-weight: bold; border-top: 2px solid #000;">
                                                <td style="padding: 10px;">Margin</td>
                                                <td><field name="margin_expected"/></td>
                                                <td><field name="margin_paid"/></td>
                                                <td>-</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_rent_contract_search" model="ir.ui.view">
            <field name="name">rent.contract.search</field>
            <field name="model">rent.contract</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" string="Contract Number"/>
                    <field name="tenant_id"/>
                    <field name="property_id"/>
                    <group expand="0" string="Group By">
                        <filter string="Residential Type" name="group_residential_type" context="{'group_by':'residential_type_id'}"/>
                        <filter string="Status" name="group_status" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>
    </data>
</odoo>