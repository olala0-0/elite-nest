<odoo>
    <data>
        <record id="res_config_settings_view_form_inherit_property_management" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.property.management</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="account.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//app[@name='account']" position="inside">
                    <block title="Property Management" name="property_management_setting_container">
                        <setting string="Lease Renewal Notice"
                                 help="How far before a contract's end date to email the tenant a renewal notice.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="renewal_notice_months" class="col-lg-3 o_light_label"/>
                                    <field name="renewal_notice_months"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Rent Invoice Defaults"
                                 help="Default product and description used when rent invoices are created from contracts.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="rent_invoice_product_id" class="col-lg-3 o_light_label"/>
                                    <field name="rent_invoice_product_id"/>
                                </div>
                                <div class="row mt16">
                                    <label for="rent_invoice_description" class="col-lg-3 o_light_label"/>
                                    <field name="rent_invoice_description"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Deposit Invoice Defaults"
                                 help="Default product and description used for security deposit invoices.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="deposit_invoice_product_id" class="col-lg-3 o_light_label"/>
                                    <field name="deposit_invoice_product_id"/>
                                </div>
                                <div class="row mt16">
                                    <label for="deposit_invoice_description" class="col-lg-3 o_light_label"/>
                                    <field name="deposit_invoice_description"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Maintenance Invoice Defaults"
                                 help="Default product and description used for maintenance lines created from contracts.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="maintenance_invoice_product_id" class="col-lg-3 o_light_label"/>
                                    <field name="maintenance_invoice_product_id"/>
                                </div>
                                <div class="row mt16">
                                    <label for="maintenance_invoice_description" class="col-lg-3 o_light_label"/>
                                    <field name="maintenance_invoice_description"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Penalty Invoice Defaults"
                                 help="Default product and description used for penalty invoices.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="penalty_invoice_product_id" class="col-lg-3 o_light_label"/>
                                    <field name="penalty_invoice_product_id"/>
                                </div>
                                <div class="row mt16">
                                    <label for="penalty_invoice_description" class="col-lg-3 o_light_label"/>
                                    <field name="penalty_invoice_description"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Ejari Fee Invoice Defaults"
                                 help="Default product and description used for the one-time Ejari Fee charge, billed once on the first invoice if set on the contract.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ejari_fee_invoice_product_id" class="col-lg-3 o_light_label"/>
                                    <field name="ejari_fee_invoice_product_id"/>
                                </div>
                                <div class="row mt16">
                                    <label for="ejari_fee_invoice_description" class="col-lg-3 o_light_label"/>
                                    <field name="ejari_fee_invoice_description"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Admin Charge Invoice Defaults"
                                 help="Default product and description used for the one-time Admin Charge, billed once on the first invoice if set on the contract.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="admin_charge_invoice_product_id" class="col-lg-3 o_light_label"/>
                                    <field name="admin_charge_invoice_product_id"/>
                                </div>
                                <div class="row mt16">
                                    <label for="admin_charge_invoice_description" class="col-lg-3 o_light_label"/>
                                    <field name="admin_charge_invoice_description"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Commission Invoice Defaults"
                                 help="Default product and description used for the one-time tenant Commission charge, billed once on the first invoice if set on the contract. Not related to Broker Commission.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="commission_invoice_product_id" class="col-lg-3 o_light_label"/>
                                    <field name="commission_invoice_product_id"/>
                                </div>
                                <div class="row mt16">
                                    <label for="commission_invoice_description" class="col-lg-3 o_light_label"/>
                                    <field name="commission_invoice_description"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Parking Fee Invoice Defaults"
                                 help="Default product and description used for the one-time Parking Fee charge, billed once on the first invoice if set on the contract.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="parking_fee_invoice_product_id" class="col-lg-3 o_light_label"/>
                                    <field name="parking_fee_invoice_product_id"/>
                                </div>
                                <div class="row mt16">
                                    <label for="parking_fee_invoice_description" class="col-lg-3 o_light_label"/>
                                    <field name="parking_fee_invoice_description"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Dilapidation Invoice Defaults"
                                 help="Default product and description used for Dilapidation charges billed through Move-Out deposit settlement.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="dilapidation_invoice_product_id" class="col-lg-3 o_light_label"/>
                                    <field name="dilapidation_invoice_product_id"/>
                                </div>
                                <div class="row mt16">
                                    <label for="dilapidation_invoice_description" class="col-lg-3 o_light_label"/>
                                    <field name="dilapidation_invoice_description"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Shortfall Rent Invoice Defaults"
                                 help="Default product and description used for Shortfall Rent charges billed through Move-Out deposit settlement.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="shortfall_rent_invoice_product_id" class="col-lg-3 o_light_label"/>
                                    <field name="shortfall_rent_invoice_product_id"/>
                                </div>
                                <div class="row mt16">
                                    <label for="shortfall_rent_invoice_description" class="col-lg-3 o_light_label"/>
                                    <field name="shortfall_rent_invoice_description"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
