<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Property Lease Contracts -->
        <record id="seq_property_contract" model="ir.sequence">
            <field name="name">Property Lease Contract</field>
            <field name="code">property.contract</field>
            <field name="prefix">PLC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Facility Work Orders -->
        <record id="seq_property_maintenance_request" model="ir.sequence">
            <field name="name">Facility Work Order</field>
            <field name="code">property.maintenance.request</field>
            <field name="prefix">WO/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Initial Asset Health Records -->
        <record id="asset_elevators" model="property.asset">
            <field name="name">Elevators &amp; Lifts</field>
            <field name="health_index">92</field>
            <field name="location_id">Main Tower Central Core</field>
            <field name="status">good</field>
        </record>
        <record id="asset_hvac" model="property.asset">
            <field name="name">Central HVAC Chillers</field>
            <field name="health_index">87</field>
            <field name="location_id">Rooftop Plant Room</field>
            <field name="status">good</field>
        </record>
        <record id="asset_fire_safety" model="property.asset">
            <field name="name">Fire Suppression &amp; Alarm</field>
            <field name="health_index">100</field>
            <field name="location_id">All Zones &amp; Risers</field>
            <field name="status">good</field>
        </record>
        <record id="asset_electrical_grid" model="property.asset">
            <field name="name">Electrical Grid &amp; Substation</field>
            <field name="health_index">94</field>
            <field name="location_id">Basement 2 Switchgear</field>
            <field name="status">good</field>
        </record>
        <record id="asset_water_pumps" model="property.asset">
            <field name="name">Potable &amp; Booster Water Pumps</field>
            <field name="health_index">81</field>
            <field name="location_id">Basement 1 Pump Station</field>
            <field name="status">warning</field>
        </record>

        <!-- Initial Utility Record -->
        <record id="util_electricity_initial" model="property.utilities">
            <field name="name">Monthly Power &amp; Water (DEWA)</field>
            <field name="utility_type">electricity</field>
            <field name="amount">42150.00</field>
            <field name="change_rate">-2.1</field>
        </record>
    </data>
</odoo>
