<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="property_dashboard_realtime.PropertyDashboard">
        <div class="o_property_dashboard_container d-flex flex-column h-100" t-att-class="{'pulse-active': state.pulseEffect}">

            <!-- ========================================================= -->
            <!-- EXECUTIVE HEADER BAR                                      -->
            <!-- ========================================================= -->
            <header class="executive-topbar px-4 py-3 d-flex flex-wrap justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <div class="brand-badge p-2 rounded-3 d-flex align-items-center justify-content-center">
                        <i class="fa fa-building-o fs-4 text-emerald"/>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h4 class="mb-0 fw-bold text-white tracking-wide">Property &amp; Lease Executive Dashboard</h4>
                            <span class="badge rounded-pill live-sync-badge d-flex align-items-center gap-1">
                                <span class="pulse-beacon"/>
                                <span t-if="state.realtimeConnected">Live Bus Real-Time</span>
                                <span t-else="">Synced</span>
                            </span>
                        </div>
                        <p class="mb-0 text-muted small">
                            Odoo 19 Enterprise Real-Time Command Center • Last update: <span class="text-white-50" t-esc="state.lastUpdated or 'Just now'"/>
                        </p>
                    </div>
                </div>

                <!-- Global Filters & Actions -->
                <div class="d-flex flex-wrap align-items-center gap-2 mt-2 mt-md-0">
                    <!-- Residential Type Filter -->
                    <div class="filter-group">
                        <select class="form-select form-select-sm executive-select" t-on-change="onFilterResidentialType" t-att-value="state.residentialType">
                            <option value="all">All Unit Types</option>
                            <option value="studio">Studio</option>
                            <option value="1bed">1 Bed Flat</option>
                            <option value="2bed">2 Bed Flat</option>
                            <option value="3bed">3 Bed Flat</option>
                            <option value="penthouse">Penthouse</option>
                            <option value="office">Commercial Office</option>
                        </select>
                    </div>

                    <!-- State Filter -->
                    <div class="filter-group">
                        <select class="form-select form-select-sm executive-select" t-on-change="onFilterState" t-att-value="state.contractState">
                            <option value="all">All Statuses</option>
                            <option value="running">Running Leases</option>
                            <option value="terminated">Terminated</option>
                            <option value="cancelled">Cancelled</option>
                            <option value="expired">Expired</option>
                        </select>
                    </div>

                    <!-- Search Input -->
                    <div class="search-input-wrapper position-relative">
                        <i class="fa fa-search search-icon position-absolute text-muted"/>
                        <input type="text"
                               class="form-control form-control-sm executive-input ps-4"
                               placeholder="Filter directory..."
                               t-att-value="state.searchQuery"
                               t-on-input="onSearchInput"/>
                    </div>

                    <!-- Action Buttons -->
                    <button class="btn btn-sm btn-executive-action" t-on-click="refreshDashboard" title="Refresh Data">
                        <i class="fa fa-refresh" t-att-class="{'fa-spin': state.loading}"/>
                    </button>
                    <button class="btn btn-sm btn-emerald text-white fw-semibold d-flex align-items-center gap-1" t-on-click="createContract">
                        <i class="fa fa-plus-circle"/>
                        <span>New Lease</span>
                    </button>
                    <button t-if="state.kpis.total_units === 0" class="btn btn-sm btn-outline-info fw-semibold" t-on-click="seedDemoData">
                        <i class="fa fa-magic me-1"/> Load Sample Portfolio
                    </button>
                </div>
            </header>

            <!-- ========================================================= -->
            <!-- MAIN SCROLLABLE CONTENT BODY                              -->
            <!-- ========================================================= -->
            <div class="dashboard-scrollable flex-grow-1 p-4 position-relative">

                <!-- Loading State Indicator -->
                <div t-if="state.loading" class="executive-loading-overlay position-absolute top-0 start-0 w-100 h-100 d-flex flex-column justify-content-center align-items-center">
                    <div class="spinner-border text-emerald mb-3" role="status"/>
                    <span class="text-white-50 small tracking-wider text-uppercase">Synchronizing Real-Time Property Metrics...</span>
                </div>

                <!-- 1. KPI SUMMARY CARDS -->
                <section class="kpi-banner-grid mb-4">
                    <!-- KPI 1: Occupancy & Units -->
                    <div class="executive-card kpi-card" t-on-click="openAllUnits">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="kpi-label">Total Units &amp; Occupancy</span>
                            <span class="kpi-icon-pill bg-emerald-subtle">
                                <i class="fa fa-building text-emerald"/>
                            </span>
                        </div>
                        <div class="kpi-value-row d-flex align-items-baseline gap-2 mb-2">
                            <h3 class="kpi-number mb-0 text-white" t-esc="state.kpis.units_ratio_text"/>
                            <span class="kpi-badge badge bg-emerald text-dark fw-bold">
                                <t t-esc="state.kpis.occupancy_rate"/>%
                            </span>
                        </div>
                        <div class="occupancy-progress-bar rounded-pill overflow-hidden">
                            <div class="progress-fill bg-emerald" t-attf-style="width: {{ state.kpis.occupancy_rate }}%;"/>
                        </div>
                        <div class="d-flex justify-content-between text-muted small mt-2">
                            <span>Occupied: <b class="text-white" t-esc="state.kpis.occupied_units"/></span>
                            <span>Total Portfolio: <b class="text-white" t-esc="state.kpis.total_units"/></span>
                        </div>
                    </div>

                    <!-- KPI 2: Vacant Units Alert -->
                    <div class="executive-card kpi-card" t-on-click="openAllUnits">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="kpi-label">Vacant Units</span>
                            <span class="kpi-icon-pill" t-att-class="state.kpis.vacant_alert ? 'bg-danger-subtle' : 'bg-emerald-subtle'">
                                <i class="fa fa-key" t-att-class="state.kpis.vacant_alert ? 'text-danger' : 'text-emerald'"/>
                            </span>
                        </div>
                        <div class="kpi-value-row d-flex align-items-baseline gap-2 mb-2">
                            <h3 class="kpi-number mb-0" t-att-class="state.kpis.vacant_alert ? 'text-danger' : 'text-white'" t-esc="state.kpis.vacant_units"/>
                            <span t-if="state.kpis.vacant_alert" class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle small">
                                <i class="fa fa-exclamation-triangle me-1"/>Attention
                            </span>
                            <span t-else="" class="badge rounded-pill bg-emerald-subtle text-emerald small">
                                100% Full
                            </span>
                        </div>
                        <p class="text-muted small mb-0 mt-3">
                            <span t-if="state.kpis.vacant_units > 0">
                                <b class="text-white" t-esc="state.kpis.vacant_units"/> units ready for immediate lease allocation.
                            </span>
                            <span t-else="">All units currently under active lease.</span>
                        </p>
                    </div>

                    <!-- KPI 3: Active Running Contracts -->
                    <div class="executive-card kpi-card" t-on-click="openAllContracts">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="kpi-label">Active Running Leases</span>
                            <span class="kpi-icon-pill bg-violet-subtle">
                                <i class="fa fa-file-text-o text-violet"/>
                            </span>
                        </div>
                        <div class="kpi-value-row d-flex align-items-baseline gap-2 mb-2">
                            <h3 class="kpi-number mb-0 text-white" t-esc="state.kpis.active_contracts_count"/>
                            <span class="badge rounded-pill bg-violet-subtle text-violet small">
                                In Force
                            </span>
                        </div>
                        <p class="text-muted small mb-0 mt-3">
                            Legally binding tenancy agreements actively generating cashflow.
                        </p>
                    </div>

                    <!-- KPI 4: Total Rent Revenue (AED) -->
                    <div class="executive-card kpi-card">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="kpi-label">Total Lease Revenue (Active)</span>
                            <span class="kpi-icon-pill bg-sky-subtle">
                                <i class="fa fa-money text-sky"/>
                            </span>
                        </div>
                        <div class="kpi-value-row d-flex align-items-baseline gap-2 mb-2">
                            <h3 class="kpi-number mb-0 text-emerald fw-bold text-truncate" t-esc="state.kpis.total_rent_revenue_formatted"/>
                        </div>
                        <p class="text-muted small mb-0 mt-3">
                            Total contracted annual rent stream formatted in AED.
                        </p>
                    </div>

                    <!-- KPI 5: Tenant Nationalities -->
                    <div class="executive-card kpi-card">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="kpi-label">Tenant Nationalities</span>
                            <span class="kpi-icon-pill bg-amber-subtle">
                                <i class="fa fa-globe text-amber"/>
                            </span>
                        </div>
                        <div class="kpi-value-row d-flex align-items-baseline gap-2 mb-2">
                            <h3 class="kpi-number mb-0 text-white" t-esc="state.kpis.distinct_nationalities_count"/>
                            <span class="badge rounded-pill bg-amber-subtle text-amber small">
                                Jurisdictions
                            </span>
                        </div>
                        <p class="text-muted small mb-0 mt-3">
                            Global demographic diversity across active leases.
                        </p>
                    </div>
                </section>

                <!-- 2. EXECUTIVE CHART VISUALIZATIONS GRID -->
                <section class="charts-section-grid mb-4">
                    <!-- Chart 1: Donut Chart - Contracts by Status -->
                    <div class="executive-card chart-card">
                        <div class="chart-header d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h6 class="mb-0 fw-semibold text-white">Lease Contracts by Status</h6>
                                <span class="text-muted small">Distribution across running, terminated, and expired</span>
                            </div>
                            <span class="badge bg-secondary-subtle text-muted small">All Portfolio</span>
                        </div>
                        <div class="chart-canvas-wrapper position-relative">
                            <canvas t-ref="statusChart"/>
                        </div>
                    </div>

                    <!-- Chart 2: Horizontal Bar Chart - Tenant Nationalities -->
                    <div class="executive-card chart-card">
                        <div class="chart-header d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h6 class="mb-0 fw-semibold text-white">Tenant Nationality Mix</h6>
                                <span class="text-muted small">Top tenant countries &amp; portfolio share</span>
                            </div>
                            <span class="badge bg-sky-subtle text-sky small">Active Leases</span>
                        </div>
                        <div class="chart-canvas-wrapper position-relative">
                            <canvas t-ref="nationalitiesChart"/>
                        </div>
                    </div>

                    <!-- Chart 3: Combo Bar - Avg Rent by Unit Type -->
                    <div class="executive-card chart-card">
                        <div class="chart-header d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h6 class="mb-0 fw-semibold text-white">Average Rent vs Benchmark (AED)</h6>
                                <span class="text-muted small">Actual average lease vs target benchmark by unit category</span>
                            </div>
                            <span class="badge bg-emerald-subtle text-emerald small">AED Pricing</span>
                        </div>
                        <div class="chart-canvas-wrapper position-relative">
                            <canvas t-ref="avgRentChart"/>
                        </div>
                    </div>

                    <!-- Chart 4: Line Area - Monthly Revenue Trend -->
                    <div class="executive-card chart-card">
                        <div class="chart-header d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h6 class="mb-0 fw-semibold text-white">Monthly Rent Stream Trend</h6>
                                <span class="text-muted small">Aggregated lease collections timeline</span>
                            </div>
                            <span class="badge bg-sky-subtle text-sky small">Revenue Stream</span>
                        </div>
                        <div class="chart-canvas-wrapper position-relative">
                            <canvas t-ref="revenueTrendChart"/>
                        </div>
                    </div>
                </section>

                <!-- 3. RECENT DIRECTORY RECORDS TABLE -->
                <section class="executive-card directory-card mb-3">
                    <div class="directory-header d-flex flex-wrap justify-content-between align-items-center p-3 border-bottom border-dark">
                        <div>
                            <h6 class="mb-0 fw-bold text-white d-flex align-items-center gap-2">
                                <i class="fa fa-list-alt text-emerald"/>
                                <span>Recent Active Lease Directory</span>
                                <span class="badge rounded-pill bg-dark text-muted ms-1" t-esc="state.recentContracts.length + ' Records'"/>
                            </h6>
                            <span class="text-muted small">Top active contracts with comparative benchmark analysis and validity tracking</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-sm btn-outline-secondary text-white-50" t-on-click="openAllContracts">
                                View All Contracts <i class="fa fa-arrow-right ms-1"/>
                            </button>
                        </div>
                    </div>

                    <!-- Table Container -->
                    <div class="table-responsive directory-table-wrapper">
                        <table class="table table-dark table-hover executive-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-4">Sequence / Ref</th>
                                    <th>Property Unit</th>
                                    <th>Unit Type</th>
                                    <th>Tenant Customer</th>
                                    <th>Nationality</th>
                                    <th class="text-end">Rent (AED)</th>
                                    <th class="text-end">Type Benchmark</th>
                                    <th class="text-center">Variance</th>
                                    <th>Lease Duration</th>
                                    <th class="text-center">Days Left</th>
                                    <th class="text-center">Status</th>
                                    <th class="text-end pe-4">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="state.recentContracts.length === 0">
                                    <tr>
                                        <td colspan="12" class="text-center py-5 text-muted">
                                            <i class="fa fa-folder-open-o fs-1 mb-2 d-block text-white-50"/>
                                            No active lease contracts found matching the selected criteria.
                                            <div class="mt-3">
                                                <button class="btn btn-sm btn-emerald text-white" t-on-click="createContract">
                                                    Create First Contract
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                </t>
                                <t t-else="">
                                    <t t-foreach="state.recentContracts" t-as="contract" t-key="contract.id">
                                        <tr class="directory-row" t-on-click="() => this.openContract(contract.id)">
                                            <!-- Sequence -->
                                            <td class="ps-4">
                                                <span class="fw-semibold text-emerald font-monospace" t-esc="contract.name"/>
                                            </td>

                                            <!-- Property Unit -->
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="fa fa-home text-muted"/>
                                                    <span class="fw-semibold text-white" t-esc="contract.unit_name"/>
                                                </div>
                                            </td>

                                            <!-- Unit Type -->
                                            <td>
                                                <span class="badge rounded-pill bg-dark border border-secondary text-light small px-2 py-1" t-esc="contract.unit_type"/>
                                            </td>

                                            <!-- Tenant Name -->
                                            <td>
                                                <span class="text-white-50 fw-medium" t-esc="contract.tenant_name"/>
                                            </td>

                                            <!-- Nationality -->
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="country-badge text-uppercase font-monospace" t-esc="contract.tenant_country_code"/>
                                                    <span class="text-muted small" t-esc="contract.tenant_country_name"/>
                                                </div>
                                            </td>

                                            <!-- Rent Amount -->
                                            <td class="text-end fw-bold text-white">
                                                <span t-esc="contract.rent_amount_formatted"/>
                                            </td>

                                            <!-- Benchmark Avg -->
                                            <td class="text-end text-muted small">
                                                <span t-esc="contract.benchmark_rent_formatted"/>
                                            </td>

                                            <!-- Variance -->
                                            <td class="text-center">
                                                <span class="badge rounded-pill"
                                                      t-att-class="contract.benchmark_diff_positive ? 'bg-emerald-subtle text-emerald' : 'bg-danger-subtle text-danger'"
                                                      t-esc="contract.benchmark_diff_pct"/>
                                            </td>

                                            <!-- Dates -->
                                            <td>
                                                <div class="text-muted small font-monospace">
                                                    <span t-esc="contract.start_date"/> → <span t-esc="contract.end_date"/>
                                                </div>
                                            </td>

                                            <!-- Remaining Days -->
                                            <td class="text-center">
                                                <span class="badge rounded-pill"
                                                      t-att-class="contract.days_remaining_class"
                                                      t-esc="contract.days_remaining + ' d'"/>
                                            </td>

                                            <!-- Status -->
                                            <td class="text-center">
                                                <span class="badge rounded-pill"
                                                      t-att-class="contract.state_badge_class"
                                                      t-esc="contract.state_label"/>
                                            </td>

                                            <!-- Action -->
                                            <td class="text-end pe-4">
                                                <button class="btn btn-sm btn-icon-subtle text-muted"
                                                        t-on-click="(ev) => this.onActionClick(ev, contract.id)"
                                                        title="Open Contract Details">
                                                    <i class="fa fa-external-link"/>
                                                </button>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </section>

            </div>
        </div>
    </t>

</templates>
