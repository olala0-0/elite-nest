<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="property_dashboard_realtime.PropertyDashboard">
        <div class="o_property_dashboard_container d-flex flex-column h-100" t-att-class="{'pulse-active': state.pulseEffect}">

            <!-- ========================================================= -->
            <!-- EXECUTIVE TOPBAR (LAVENDER TINTED)                        -->
            <!-- ========================================================= -->
            <header class="executive-topbar px-4 py-3 d-flex flex-wrap justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <div class="brand-badge p-2 rounded-3 d-flex align-items-center justify-content-center">
                        <i class="fa fa-building-o fs-4" style="color: var(--dash-primary-lavender);"/>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h4 class="mb-0 fw-bold tracking-wide" style="color: var(--dash-lavender-light);">Property &amp; Contract Executive Dashboard</h4>
                            <span class="badge rounded-pill live-sync-badge d-flex align-items-center gap-1">
                                <span class="pulse-beacon"/>
                                <span t-if="state.realtimeConnected">Live Real-Time</span>
                                <span t-else="">Synced</span>
                            </span>
                            <span t-if="state.multiCompany.active_company_name" class="badge rounded-pill company-pill d-none d-md-inline-flex align-items-center gap-1">
                                <i class="fa fa-briefcase text-muted"/>
                                <span t-esc="state.multiCompany.active_company_name"/>
                            </span>
                        </div>
                        <p class="mb-0 small" style="color: var(--dash-lavender-medium);">
                            Odoo 19 Enterprise Multi-Company Command Center • Last updated: <span class="fw-semibold" style="color: var(--dash-primary-lavender);" t-esc="state.lastUpdated or 'Just now'"/>
                        </p>
                    </div>
                </div>

                <!-- Global Filters & Actions -->
                <div class="d-flex flex-wrap align-items-center gap-2 mt-2 mt-md-0">
                    <!-- Residential Type Filter -->
                    <div class="filter-group">
                        <select class="form-select form-select-sm executive-select" t-on-change="onFilterResidentialType" t-att-value="state.residentialType">
                            <option value="all">All Property Types</option>
                            <option value="studio">Studio</option>
                            <option value="1">1 Bed Flat</option>
                            <option value="2">2 Bed Flat</option>
                            <option value="3">3 Bed Flat</option>
                            <option value="pent">Penthouse</option>
                            <option value="office">Commercial Office</option>
                        </select>
                    </div>

                    <!-- Contract State Filter -->
                    <div class="filter-group">
                        <select class="form-select form-select-sm executive-select" t-on-change="onFilterState" t-att-value="state.contractState">
                            <option value="all">All Contract Statuses</option>
                            <option value="running">Running Contracts</option>
                            <option value="expired">Expired Contracts</option>
                            <option value="terminated">Terminated Contracts</option>
                            <option value="cancelled">Cancelled Contracts</option>
                        </select>
                    </div>

                    <!-- Search Input -->
                    <div class="search-input-wrapper position-relative">
                        <i class="fa fa-search search-icon position-absolute"/>
                        <input type="text"
                               class="form-control form-control-sm executive-input ps-4"
                               placeholder="Filter contracts / properties..."
                               t-att-value="state.searchQuery"
                               t-on-input="onSearchInput"/>
                    </div>

                    <!-- Action Buttons -->
                    <button class="btn btn-sm btn-executive-action" t-on-click="refreshDashboard" title="Refresh Live Data">
                        <i class="fa fa-refresh" t-att-class="{'fa-spin': state.loading}"/>
                    </button>
                    <button class="btn btn-sm btn-lavender fw-semibold d-flex align-items-center gap-1" t-on-click="createContract">
                        <i class="fa fa-plus-circle"/>
                        <span>New Contract</span>
                    </button>
                    <button class="btn btn-sm btn-outline-primary fw-semibold d-flex align-items-center gap-1" t-on-click="createMaintenance">
                        <i class="fa fa-wrench"/>
                        <span>New Maintenance</span>
                    </button>
                </div>
            </header>

            <!-- ========================================================= -->
            <!-- MAIN SCROLLABLE CONTENT BODY                              -->
            <!-- ========================================================= -->
            <div class="dashboard-scrollable flex-grow-1 p-4 position-relative">

                <!-- Loading State Indicator -->
                <div t-if="state.loading" class="executive-loading-overlay position-absolute top-0 start-0 w-100 h-100 d-flex flex-column justify-content-center align-items-center">
                    <div class="spinner-border mb-3" role="status" style="color: var(--dash-primary-lavender);"/>
                    <span class="small tracking-wider text-uppercase fw-semibold" style="color: var(--dash-lavender-medium);">Loading Real-Time Property &amp; Contract Data...</span>
                </div>

                <!-- 1. KPI SUMMARY CARDS -->
                <section class="kpi-banner-grid mb-4">
                    <!-- KPI 1: Occupancy & Properties -->
                    <div class="executive-card kpi-card" t-on-click="openAllProperties" title="Click to view Properties">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="kpi-label">Properties &amp; Occupancy</span>
                            <span class="kpi-icon-pill">
                                <i class="fa fa-building"/>
                            </span>
                        </div>
                        <div class="kpi-value-row d-flex align-items-baseline gap-2 mb-2">
                            <h3 class="kpi-number mb-0" t-esc="state.kpis.units_ratio_text"/>
                            <span class="kpi-badge badge bg-emerald text-dark fw-bold">
                                <t t-esc="state.kpis.occupancy_rate"/>%
                            </span>
                        </div>
                        <div class="occupancy-progress-bar rounded-pill overflow-hidden">
                            <div class="progress-fill" t-attf-style="width: {{ state.kpis.occupancy_rate }}%;"/>
                        </div>
                        <div class="d-flex justify-content-between small mt-2" style="color: var(--dash-lavender-medium);">
                            <span>Occupied: <b style="color: var(--dash-lavender-light);" t-esc="state.kpis.occupied_units"/></span>
                            <span>Total Properties: <b style="color: var(--dash-lavender-light);" t-esc="state.kpis.total_units"/></span>
                        </div>
                    </div>

                    <!-- KPI 2: Vacant Properties Alert -->
                    <div class="executive-card kpi-card" t-on-click="openAllProperties" title="Click to view Properties">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="kpi-label">Vacant Properties</span>
                            <span class="kpi-icon-pill" t-att-class="state.kpis.vacant_alert ? 'bg-danger-subtle' : 'bg-emerald-subtle'">
                                <i class="fa fa-key" t-att-class="state.kpis.vacant_alert ? 'text-rose' : 'text-lavender'"/>
                            </span>
                        </div>
                        <div class="kpi-value-row d-flex align-items-baseline gap-2 mb-2">
                            <h3 class="kpi-number mb-0" t-att-class="state.kpis.vacant_alert ? 'text-rose' : ''" t-esc="state.kpis.vacant_units"/>
                            <span t-if="state.kpis.vacant_alert" class="badge rounded-pill bg-danger-subtle small">
                                <i class="fa fa-exclamation-triangle me-1"/>Available
                            </span>
                            <span t-else="" class="badge rounded-pill bg-emerald-subtle small">
                                100% Full
                            </span>
                        </div>
                        <p class="small mb-0 mt-3" style="color: var(--dash-lavender-medium);">
                            <span t-if="state.kpis.vacant_units > 0">
                                <b style="color: var(--dash-lavender-light);" t-esc="state.kpis.vacant_units"/> properties vacant &amp; ready for leasing.
                            </span>
                            <span t-else="">All properties currently under active contract.</span>
                        </p>
                    </div>

                    <!-- KPI 3: Active Running Contracts -->
                    <div class="executive-card kpi-card" t-on-click="openAllContracts" title="Click to view Rent Contracts">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="kpi-label">Active Contracts</span>
                            <span class="kpi-icon-pill">
                                <i class="fa fa-file-text-o"/>
                            </span>
                        </div>
                        <div class="kpi-value-row d-flex align-items-baseline gap-2 mb-2">
                            <h3 class="kpi-number mb-0" t-esc="state.kpis.active_contracts_count"/>
                            <span class="badge rounded-pill bg-violet-subtle small">
                                In Force
                            </span>
                        </div>
                        <p class="small mb-0 mt-3" style="color: var(--dash-lavender-medium);">
                            Active legally binding rent contracts generating revenue.
                        </p>
                    </div>

                    <!-- KPI 4: Total Contract Revenue (AED) -->
                    <div class="executive-card kpi-card">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="kpi-label">Total Contract Revenue</span>
                            <span class="kpi-icon-pill">
                                <i class="fa fa-money"/>
                            </span>
                        </div>
                        <div class="kpi-value-row d-flex align-items-baseline gap-2 mb-2">
                            <h3 class="kpi-number mb-0 fw-bold text-truncate" style="color: var(--dash-primary-lavender);" t-esc="state.kpis.total_rent_revenue_formatted"/>
                        </div>
                        <p class="small mb-0 mt-3" style="color: var(--dash-lavender-medium);">
                            Total contracted annual rent stream formatted in AED.
                        </p>
                    </div>

                    <!-- KPI 5: Maintenance Requests -->
                    <div class="executive-card kpi-card" t-on-click="openAllMaintenance" title="Click to view Maintenance Requests">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="kpi-label">Maintenance Requests</span>
                            <span class="kpi-icon-pill">
                                <i class="fa fa-wrench"/>
                            </span>
                        </div>
                        <div class="kpi-value-row d-flex align-items-baseline gap-2 mb-2">
                            <h3 class="kpi-number mb-0" t-esc="state.kpis.maintenance_open"/>
                            <span class="badge rounded-pill bg-sky-subtle small">
                                Open / Pending
                            </span>
                        </div>
                        <div class="d-flex justify-content-between small mt-2" style="color: var(--dash-lavender-medium);">
                            <span>Repaired: <b style="color: var(--dash-lavender-light);" t-esc="state.kpis.maintenance_repaired"/></span>
                            <span>Total Requests: <b style="color: var(--dash-lavender-light);" t-esc="state.kpis.maintenance_total"/></span>
                        </div>
                    </div>
                </section>

                <!-- 2. EXECUTIVE CHART VISUALIZATIONS GRID -->
                <section class="charts-section-grid mb-4">
                    <!-- Chart 1: Donut Chart - Contracts by Status -->
                    <div class="executive-card chart-card">
                        <div class="chart-header d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h6 class="mb-0 fw-bold" style="color: var(--dash-lavender-light);">Contracts by Status</h6>
                                <span class="small" style="color: var(--dash-lavender-medium);">Distribution across Running, Expired, Terminated, and Cancelled</span>
                            </div>
                            <span class="badge bg-secondary-subtle small">Rent Contracts</span>
                        </div>
                        <div class="chart-canvas-wrapper position-relative">
                            <canvas t-ref="statusChart"/>
                        </div>
                    </div>

                    <!-- Chart 2: Horizontal Bar Chart - Tenant Nationalities -->
                    <div class="executive-card chart-card">
                        <div class="chart-header d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h6 class="mb-0 fw-bold" style="color: var(--dash-lavender-light);">Tenant Nationality Mix</h6>
                                <span class="small" style="color: var(--dash-lavender-medium);">Top tenant countries &amp; portfolio share</span>
                            </div>
                            <span class="badge bg-sky-subtle small">Active Contracts</span>
                        </div>
                        <div class="chart-canvas-wrapper position-relative">
                            <canvas t-ref="nationalitiesChart"/>
                        </div>
                    </div>

                    <!-- Chart 3: Combo Bar - Avg Rent by Residential Type -->
                    <div class="executive-card chart-card">
                        <div class="chart-header d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h6 class="mb-0 fw-bold" style="color: var(--dash-lavender-light);">Average Contract Rent vs Benchmark</h6>
                                <span class="small" style="color: var(--dash-lavender-medium);">Actual average contract rent (AED) vs target benchmark by type</span>
                            </div>
                            <span class="badge bg-emerald-subtle small">AED Pricing</span>
                        </div>
                        <div class="chart-canvas-wrapper position-relative">
                            <canvas t-ref="avgRentChart"/>
                        </div>
                    </div>

                    <!-- Chart 4: Line Area - Monthly Revenue Trend -->
                    <div class="executive-card chart-card">
                        <div class="chart-header d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h6 class="mb-0 fw-bold" style="color: var(--dash-lavender-light);">Monthly Contract Rent Inflows</h6>
                                <span class="small" style="color: var(--dash-lavender-medium);">Aggregated contract rent timeline</span>
                            </div>
                            <span class="badge bg-sky-subtle small">Cashflow</span>
                        </div>
                        <div class="chart-canvas-wrapper position-relative">
                            <canvas t-ref="revenueTrendChart"/>
                        </div>
                    </div>
                </section>

                <!-- 3. MAINTENANCE REQUESTS SECTION (Related to Properties) -->
                <section t-if="state.recentMaintenance.length > 0" class="executive-card directory-card mb-4">
                    <div class="directory-header d-flex flex-wrap justify-content-between align-items-center p-3 border-bottom" style="border-color: var(--dash-border-color) !important;">
                        <div>
                            <h6 class="mb-0 fw-bold d-flex align-items-center gap-2" style="color: var(--dash-lavender-light);">
                                <i class="fa fa-wrench" style="color: var(--dash-primary-lavender);"/>
                                <span>Recent Unit Maintenance Requests</span>
                                <span class="badge rounded-pill bg-sky-subtle ms-1" t-esc="state.recentMaintenance.length + ' Active'"/>
                            </h6>
                            <span class="small" style="color: var(--dash-lavender-medium);">Maintenance jobs and repair tickets linked to property units</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-sm btn-outline-primary" t-on-click="openAllMaintenance">
                                View All Maintenance <i class="fa fa-arrow-right ms-1"/>
                            </button>
                        </div>
                    </div>

                    <div class="table-responsive directory-table-wrapper">
                        <table class="table executive-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-4">Request Subject</th>
                                    <th>Property Unit</th>
                                    <th>Stage</th>
                                    <th>Priority</th>
                                    <th>Request Date</th>
                                    <th>Technician</th>
                                    <th class="text-end pe-4">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.recentMaintenance" t-as="m" t-key="m.id">
                                    <tr class="directory-row" t-on-click="() => this.openMaintenance(m.id)">
                                        <td class="ps-4 fw-semibold" style="color: var(--dash-lavender-light);">
                                            <span t-esc="m.name"/>
                                        </td>
                                        <td>
                                            <span class="fw-medium" style="color: var(--dash-lavender-medium);" t-esc="m.property_name"/>
                                        </td>
                                        <td>
                                            <span class="badge rounded-pill bg-sky-subtle" t-esc="m.stage_name"/>
                                        </td>
                                        <td>
                                            <span t-if="m.priority === '3'" class="badge rounded-pill bg-danger-subtle">Urgent</span>
                                            <span t-elif="m.priority === '2'" class="badge rounded-pill bg-amber-subtle">High</span>
                                            <span t-else="" class="badge rounded-pill bg-secondary-subtle">Normal</span>
                                        </td>
                                        <td class="small" style="color: var(--dash-lavender-medium);" t-esc="m.request_date"/>
                                        <td style="color: var(--dash-lavender-medium);" t-esc="m.technician"/>
                                        <td class="text-end pe-4" t-on-click.stop="">
                                            <button class="btn btn-sm btn-icon-subtle" t-on-click="() => this.openMaintenance(m.id)" title="Open Request">
                                                <i class="fa fa-external-link"/>
                                            </button>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </section>

                <!-- 4. RECENT CONTRACT DIRECTORY TABLE -->
                <section class="executive-card directory-card mb-3">
                    <div class="directory-header d-flex flex-wrap justify-content-between align-items-center p-3 border-bottom" style="border-color: var(--dash-border-color) !important;">
                        <div>
                            <h6 class="mb-0 fw-bold d-flex align-items-center gap-2" style="color: var(--dash-lavender-light);">
                                <i class="fa fa-list-alt" style="color: var(--dash-primary-lavender);"/>
                                <span>Recent Rent Contracts Directory</span>
                                <span class="badge rounded-pill bg-secondary-subtle ms-1" t-esc="state.recentContracts.length + ' Records'"/>
                            </h6>
                            <span class="small" style="color: var(--dash-lavender-medium);">Live contracts with comparative price benchmarks and validity tracking</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-sm btn-outline-primary" t-on-click="openAllContracts">
                                View All Contracts <i class="fa fa-arrow-right ms-1"/>
                            </button>
                        </div>
                    </div>

                    <!-- Table Container -->
                    <div class="table-responsive directory-table-wrapper">
                        <table class="table executive-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-4">Sequence / Ref</th>
                                    <th>Property Unit</th>
                                    <th>Residential Type</th>
                                    <th>Tenant / Customer</th>
                                    <th>Nationality</th>
                                    <th class="text-end">Rent (AED)</th>
                                    <th class="text-end">Benchmark</th>
                                    <th class="text-center">Variance</th>
                                    <th>Contract Duration</th>
                                    <th class="text-center">Days Left</th>
                                    <th class="text-center">Status</th>
                                    <th class="text-end pe-4">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="state.recentContracts.length === 0">
                                    <tr>
                                        <td colspan="12" class="text-center py-5" style="color: var(--dash-lavender-medium);">
                                            <i class="fa fa-folder-open-o fs-1 mb-2 d-block" style="color: var(--dash-lavender-dark);"/>
                                            No contracts found matching the selected criteria.
                                            <div class="mt-3">
                                                <button class="btn btn-sm btn-lavender" t-on-click="createContract">
                                                    Create New Contract
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                </t>
                                <t t-else="">
                                    <t t-foreach="state.recentContracts" t-as="contract" t-key="contract.id">
                                        <tr class="directory-row" t-on-click="() => this.openContract(contract.id)">
                                            <!-- Sequence -->
                                            <td class="ps-4">
                                                <span class="fw-semibold font-monospace" style="color: var(--dash-primary-lavender);" t-esc="contract.name"/>
                                            </td>

                                            <!-- Property Unit -->
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="fa fa-home" style="color: var(--dash-lavender-medium);"/>
                                                    <span class="fw-semibold" style="color: var(--dash-lavender-light);" t-esc="contract.unit_name"/>
                                                </div>
                                            </td>

                                            <!-- Residential Type (Tone 5 Badges) -->
                                            <td>
                                                <span t-if="contract.unit_type.toLowerCase().includes('studio')"
                                                      class="badge rounded-pill small px-2 py-1 badge-type-studio"
                                                      t-esc="contract.unit_type"/>
                                                <span t-elif="contract.unit_type.toLowerCase().includes('1')"
                                                      class="badge rounded-pill small px-2 py-1 badge-type-1bed"
                                                      t-esc="contract.unit_type"/>
                                                <span t-elif="contract.unit_type.toLowerCase().includes('2')"
                                                      class="badge rounded-pill small px-2 py-1 badge-type-2bed"
                                                      t-esc="contract.unit_type"/>
                                                <span t-elif="contract.unit_type.toLowerCase().includes('office')"
                                                      class="badge rounded-pill small px-2 py-1 badge-type-office"
                                                      t-esc="contract.unit_type"/>
                                                <span t-else=""
                                                      class="badge rounded-pill small px-2 py-1 badge-type-3bed"
                                                      t-esc="contract.unit_type"/>
                                            </td>

                                            <!-- Tenant Name -->
                                            <td>
                                                <span class="fw-medium" style="color: var(--dash-lavender-light);" t-esc="contract.tenant_name"/>
                                            </td>

                                            <!-- Nationality -->
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="country-badge text-uppercase font-monospace" t-esc="contract.tenant_country_code"/>
                                                    <span class="small" style="color: var(--dash-lavender-medium);" t-esc="contract.tenant_country_name"/>
                                                </div>
                                            </td>

                                            <!-- Rent Amount -->
                                            <td class="text-end fw-bold" style="color: var(--dash-lavender-light);">
                                                <span t-esc="contract.rent_amount_formatted"/>
                                            </td>

                                            <!-- Benchmark Avg -->
                                            <td class="text-end small" style="color: var(--dash-lavender-medium);">
                                                <span t-esc="contract.benchmark_rent_formatted"/>
                                            </td>

                                            <!-- Variance -->
                                            <td class="text-center">
                                                <span class="badge rounded-pill"
                                                      t-att-class="contract.benchmark_diff_positive ? 'bg-emerald-subtle' : 'bg-danger-subtle'"
                                                      t-esc="contract.benchmark_diff_pct"/>
                                            </td>

                                            <!-- Dates -->
                                            <td>
                                                <div class="small font-monospace" style="color: var(--dash-lavender-medium);">
                                                    <span t-esc="contract.start_date"/> → <span t-esc="contract.end_date"/>
                                                </div>
                                            </td>

                                            <!-- Remaining Days -->
                                            <td class="text-center">
                                                <span class="badge rounded-pill"
                                                      t-att-class="contract.days_remaining_class"
                                                      t-esc="contract.days_remaining + ' d'"/>
                                            </td>

                                            <!-- Status (Tones 1-4) -->
                                            <td class="text-center">
                                                <span class="badge rounded-pill"
                                                      t-att-class="contract.state_badge_class"
                                                      t-esc="contract.state_label"/>
                                            </td>

                                            <!-- Action -->
                                            <td class="text-end pe-4">
                                                <button class="btn btn-sm btn-icon-subtle"
                                                        t-on-click="(ev) => this.onActionClick(ev, contract.id)"
                                                        title="Open Contract Details">
                                                    <i class="fa fa-external-link"/>
                                                </button>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </section>

            </div>
        </div>
    </t>

</templates>
