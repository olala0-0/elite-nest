<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ========================================================= -->
        <!-- CLIENT ACTION: REAL-TIME EXECUTIVE DASHBOARD               -->
        <!-- ========================================================= -->
        <record id="action_property_realtime_dashboard" model="ir.actions.client">
            <field name="name">Real-Time Executive Property Dashboard</field>
            <field name="tag">property_realtime_dashboard</field>
            <field name="target">current</field>
        </record>

        <!-- ========================================================= -->
        <!-- PROPERTY UNIT VIEWS                                       -->
        <!-- ========================================================= -->
        <record id="view_property_unit_list" model="ir.ui.view">
            <field name="name">property.unit.list</field>
            <field name="model">property.unit</field>
            <field name="arch" type="xml">
                <list string="Property Units" decoration-success="status == 'occupied'" decoration-warning="status == 'vacant'">
                    <field name="name"/>
                    <field name="unit_type"/>
                    <field name="status" widget="badge" decoration-success="status == 'occupied'" decoration-warning="status == 'vacant'"/>
                    <field name="area_sqft"/>
                    <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="currency_id" column_invisible="True"/>
                </list>
            </field>
        </record>

        <record id="view_property_unit_form" model="ir.ui.view">
            <field name="name">property.unit.form</field>
            <field name="model">property.unit</field>
            <field name="arch" type="xml">
                <form string="Property Unit">
                    <header>
                        <field name="status" widget="statusbar" statusbar_visible="vacant,occupied"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only" string="Unit Name / Number"/>
                            <h1><field name="name" placeholder="e.g. Burj Crown Apt 1204"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="unit_type"/>
                                <field name="area_sqft"/>
                            </group>
                            <group>
                                <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lease History" name="contracts">
                                <field name="contract_ids" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="partner_id"/>
                                        <field name="rent_amount"/>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                        <field name="days_remaining"/>
                                        <field name="state" widget="badge"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_property_unit_search" model="ir.ui.view">
            <field name="name">property.unit.search</field>
            <field name="model">property.unit</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="unit_type"/>
                    <filter string="Occupied" name="filter_occupied" domain="[('status', '=', 'occupied')]"/>
                    <filter string="Vacant" name="filter_vacant" domain="[('status', '=', 'vacant')]"/>
                    <group>
                        <filter string="Unit Type" name="group_unit_type" context="{'group_by': 'unit_type'}"/>
                        <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_property_unit" model="ir.actions.act_window">
            <field name="name">Units</field>
            <field name="res_model">property.unit</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_property_unit_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Register your first property unit
                </p>
            </field>
        </record>

        <!-- ========================================================= -->
        <!-- PROPERTY CONTRACT VIEWS                                   -->
        <!-- ========================================================= -->
        <record id="view_property_contract_list" model="ir.ui.view">
            <field name="name">property.contract.list</field>
            <field name="model">property.contract</field>
            <field name="arch" type="xml">
                <list string="Property Contracts" decoration-success="state == 'running'" decoration-danger="state == 'terminated'" decoration-muted="state == 'cancelled'" decoration-warning="state == 'expired'">
                    <field name="name"/>
                    <field name="property_id"/>
                    <field name="residential_type"/>
                    <field name="partner_id"/>
                    <field name="tenant_country_id"/>
                    <field name="rent_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="currency_id" column_invisible="True"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="days_remaining" widget="integer"/>
                    <field name="state" widget="badge" decoration-success="state == 'running'" decoration-danger="state == 'terminated'" decoration-muted="state == 'cancelled'" decoration-warning="state == 'expired'"/>
                </list>
            </field>
        </record>

        <record id="view_property_contract_form" model="ir.ui.view">
            <field name="name">property.contract.form</field>
            <field name="model">property.contract</field>
            <field name="arch" type="xml">
                <form string="Property Contract">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="running,expired,terminated,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only" string="Contract Reference"/>
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group string="Property &amp; Tenant">
                                <field name="property_id"/>
                                <field name="residential_type"/>
                                <field name="partner_id"/>
                                <field name="tenant_country_id"/>
                            </group>
                            <group string="Lease Financials &amp; Timeline">
                                <field name="rent_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="duration_months"/>
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="days_remaining"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_property_contract_search" model="ir.ui.view">
            <field name="name">property.contract.search</field>
            <field name="model">property.contract</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="property_id"/>
                    <field name="partner_id"/>
                    <field name="tenant_country_id"/>
                    <filter string="Active Running" name="filter_running" domain="[('state', '=', 'running')]"/>
                    <filter string="Expired" name="filter_expired" domain="[('state', '=', 'expired')]"/>
                    <filter string="Terminated" name="filter_terminated" domain="[('state', '=', 'terminated')]"/>
                    <group>
                        <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Residential Type" name="group_type" context="{'group_by': 'residential_type'}"/>
                        <filter string="Tenant Country" name="group_country" context="{'group_by': 'tenant_country_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_property_contract" model="ir.actions.act_window">
            <field name="name">Rent Contracts</field>
            <field name="res_model">property.contract</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_property_contract_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new Rent Contract
                </p>
            </field>
        </record>

        <!-- ========================================================= -->
        <!-- FACILITY WORK ORDERS (PROPERTY MAINTENANCE) VIEWS         -->
        <!-- ========================================================= -->
        <record id="view_property_maintenance_request_list" model="ir.ui.view">
            <field name="name">property.maintenance.request.list</field>
            <field name="model">property.maintenance.request</field>
            <field name="arch" type="xml">
                <list string="Facility Work Orders" decoration-danger="priority == 'critical'" decoration-warning="priority == 'high'">
                    <field name="name"/>
                    <field name="title"/>
                    <field name="property_id"/>
                    <field name="facility_type" widget="badge"/>
                    <field name="priority" widget="badge" decoration-danger="priority == 'critical'" decoration-warning="priority == 'high'" decoration-info="priority == 'normal'"/>
                    <field name="assigned_team"/>
                    <field name="response_time_hrs"/>
                    <field name="sla_met" widget="boolean_toggle"/>
                    <field name="state" widget="badge" decoration-success="state == 'completed'" decoration-info="state == 'in_progress'" decoration-warning="state == 'scheduled'"/>
                    <field name="request_date"/>
                </list>
            </field>
        </record>

        <record id="view_property_maintenance_request_form" model="ir.ui.view">
            <field name="name">property.maintenance.request.form</field>
            <field name="model">property.maintenance.request</field>
            <field name="arch" type="xml">
                <form string="Facility Work Order">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,in_progress,completed,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only" string="Work Order Reference"/>
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group string="Task Details">
                                <field name="title"/>
                                <field name="property_id"/>
                                <field name="facility_type"/>
                                <field name="priority"/>
                            </group>
                            <group string="SLA &amp; Assignment">
                                <field name="assigned_team"/>
                                <field name="technician_id"/>
                                <field name="response_time_hrs"/>
                                <field name="sla_met"/>
                                <field name="cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="request_date"/>
                                <field name="scheduled_date"/>
                                <field name="completion_date"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_property_maintenance_request" model="ir.actions.act_window">
            <field name="name">Facility Work Orders</field>
            <field name="res_model">property.maintenance.request</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new facility work order
                </p>
            </field>
        </record>

        <!-- ========================================================= -->
        <!-- PROPERTY UTILITIES & ESG VIEWS                            -->
        <!-- ========================================================= -->
        <record id="view_property_utilities_list" model="ir.ui.view">
            <field name="name">property.utilities.list</field>
            <field name="model">property.utilities</field>
            <field name="arch" type="xml">
                <list string="Property Utilities &amp; ESG">
                    <field name="name"/>
                    <field name="property_id"/>
                    <field name="utility_type" widget="badge"/>
                    <field name="billing_period"/>
                    <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="change_rate"/>
                    <field name="currency_id" column_invisible="True"/>
                </list>
            </field>
        </record>

        <record id="view_property_utilities_form" model="ir.ui.view">
            <field name="name">property.utilities.form</field>
            <field name="model">property.utilities</field>
            <field name="arch" type="xml">
                <form string="Utility Bill / ESG Record">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="property_id"/>
                                <field name="utility_type"/>
                            </group>
                            <group>
                                <field name="billing_period"/>
                                <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="change_rate"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_property_utilities" model="ir.actions.act_window">
            <field name="name">Property Utilities &amp; ESG</field>
            <field name="res_model">property.utilities</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- ========================================================= -->
        <!-- FACILITY ASSET HEALTH VIEWS                               -->
        <!-- ========================================================= -->
        <record id="view_property_asset_list" model="ir.ui.view">
            <field name="name">property.asset.list</field>
            <field name="model">property.asset</field>
            <field name="arch" type="xml">
                <list string="Facility Asset Health" decoration-danger="status == 'critical'" decoration-warning="status == 'warning'" decoration-success="status == 'good'">
                    <field name="name"/>
                    <field name="health_index" widget="progressbar"/>
                    <field name="location_id"/>
                    <field name="property_id"/>
                    <field name="status" widget="badge" decoration-success="status == 'good'" decoration-warning="status == 'warning'" decoration-danger="status == 'critical'"/>
                    <field name="last_inspection"/>
                    <field name="next_maintenance"/>
                </list>
            </field>
        </record>

        <record id="view_property_asset_form" model="ir.ui.view">
            <field name="name">property.asset.form</field>
            <field name="model">property.asset</field>
            <field name="arch" type="xml">
                <form string="Facility Asset">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="health_index"/>
                                <field name="location_id"/>
                            </group>
                            <group>
                                <field name="property_id"/>
                                <field name="status"/>
                                <field name="last_inspection"/>
                                <field name="next_maintenance"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_property_asset" model="ir.actions.act_window">
            <field name="name">Facility Assets</field>
            <field name="res_model">property.asset</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- ========================================================= -->
        <!-- STANDALONE APP MENU ARCHITECTURE                         -->
        <!-- ========================================================= -->
        <!-- Standalone top-level App icon on Odoo Enterprise App Switcher -->
        <menuitem id="menu_property_dashboard_root"
                  name="Property Dashboard"
                  web_icon="property_dashboard_realtime,static/description/icon.svg"
                  action="action_property_realtime_dashboard"
                  sequence="5"/>

        <!-- Standalone App Sub-Navigation -->
        <menuitem id="menu_property_realtime_dashboard"
                  name="Executive Dashboard"
                  parent="menu_property_dashboard_root"
                  action="action_property_realtime_dashboard"
                  sequence="1"/>

        <menuitem id="menu_property_units"
                  name="Properties"
                  parent="menu_property_dashboard_root"
                  action="eg_property_management.action_property_detail"
                  sequence="10"/>

        <menuitem id="menu_property_contracts"
                  name="Rent Contracts"
                  parent="menu_property_dashboard_root"
                  action="eg_property_management.action_rent_contracts"
                  sequence="20"/>

        <menuitem id="menu_facility_work_orders"
                  name="Facility Work Orders"
                  parent="menu_property_dashboard_root"
                  action="action_property_maintenance_request"
                  sequence="30"/>

        <menuitem id="menu_facility_assets"
                  name="Asset Health"
                  parent="menu_property_dashboard_root"
                  action="action_property_asset"
                  sequence="40"/>

        <menuitem id="menu_property_utilities_nav"
                  name="Utilities &amp; ESG"
                  parent="menu_property_dashboard_root"
                  action="action_property_utilities"
                  sequence="50"/>

    </data>
</odoo>
