<odoo>
    <record id="rent_contract_extend_wizard_form_view" model="ir.ui.view">
        <field name="name">rent.contract.extend.wizard.form</field>
        <field name="model">rent.contract.extend.wizard</field>
        <field name="arch" type="xml">
            <form string="Extend Contract">
                <group>
<!--                    <field name="contract_id"/>-->
                    <field name="new_end_date"/>
                </group>
                <footer>
                    <button name="action_extend_contract" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_rent_contract_extend_wizard" model="ir.actions.act_window">
        <field name="name">Extend Contract</field>
        <field name="res_model">rent.contract.extend.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
