<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sbs_project_extension_financials_list" model="ir.ui.view">
        <field name="name">sbs_project_extension.project.financials.list</field>
        <field name="model">sbs_project_extension.project.financial</field>
        <field name="group_ids" eval="[(4, ref('group_sbs_project_financial_user'))]"/>
        <field name="arch" type="xml">
            <list string="Financials" create="false" delete="false">
                <field name="project_id" options="{'no_open': True}"/>
                <field name="company_id" optional="hide"/>
                <field name="currency_id" optional="hide"/>
                <field name="proposed_value"/>
                <field name="locked_value"/>
                <field name="revised_value"/>
            </list>
        </field>
    </record>

    <record id="view_sbs_project_extension_financials_form" model="ir.ui.view">
        <field name="name">sbs_project_extension.project.financials.form</field>
        <field name="model">sbs_project_extension.project.financial</field>
        <field name="group_ids" eval="[(4, ref('group_sbs_project_financial_user'))]"/>
        <field name="arch" type="xml">
            <form string="Project Financials" create="false" delete="false">
                <sheet>
                    <group>
                        <field name="project_id" readonly="1" options="{'no_open': True}"/>
                        <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        <field name="currency_id" readonly="1"/>
                    </group>
                    <group string="Financial Values">
                        <field name="proposed_value"/>
                        <field name="locked_value"/>
                        <field name="revised_value"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sbs_project_extension_financials_search" model="ir.ui.view">
        <field name="name">sbs_project_extension.project.financials.search</field>
        <field name="model">sbs_project_extension.project.financial</field>
        <field name="group_ids" eval="[(4, ref('group_sbs_project_financial_user'))]"/>
        <field name="arch" type="xml">
            <search string="Search Project Financials">
                <field name="project_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="action_sbs_project_extension_financials" model="ir.actions.act_window">
        <field name="name">Financials</field>
        <field name="res_model">sbs_project_extension.project.financial</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_sbs_project_extension_financials_list"/>
        <field name="search_view_id" ref="view_sbs_project_extension_financials_search"/>
    </record>
</odoo>
